# ----------------------------------------------------------------------------
# Required for every deployment
# ----------------------------------------------------------------------------

# Postgres with pgvector (Neon, Supabase, etc.)
DATABASE_URL=

# Better Auth -- generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM key used to encrypt user-supplied API keys at rest.
# 32 bytes -- generate with `openssl rand -hex 32` (64 hex chars).
# DO NOT change this once users have saved credentials -- their keys become
# unrecoverable. Keep it in your secret manager.
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Optional fallbacks
#
# Users normally configure their own AI provider keys from the in-app settings
# dashboard (/settings/providers), which encrypts and stores them in the DB.
# The variables below are only used as a safety-net default for the
# maintainer's own deployment during the migration period -- they're not
# required for new forks.
# ----------------------------------------------------------------------------

GOOGLE_GENERATIVE_AI_API_KEY=
# Legacy alias still read for backwards-compat:
GOOGLE_GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# Authentication providers (optional)
# ----------------------------------------------------------------------------

# Google OAuth -- leave empty to disable Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Web search (optional -- powers /api/deep-research)
#
# Pick one or more. Default fallback chain is exa -> tavily -> searxng;
# override with SEARCH_PROVIDER_ORDER (comma-separated). Each provider is
# only enabled when its config is present.
# ----------------------------------------------------------------------------

EXA_API_KEY=
TAVILY_API_KEY=
SERPAPI_KEY=

# SearxNG (open-source, self-hostable meta-search). Point at your own
# instance: https://docs.searxng.org/admin/installation.html
# Public instances exist (e.g. https://searx.be) but rate-limit
# unpredictably -- prefer self-hosting for production workloads.
# SEARXNG_URL=http://localhost:8080

# Optional: bias the fallback order. e.g. SearxNG-first if you prefer OSS:
# SEARCH_PROVIDER_ORDER=searxng,exa,tavily

# ----------------------------------------------------------------------------
# File storage -- pick one
# ----------------------------------------------------------------------------

# STORAGE_PROVIDER=supabase | r2
STORAGE_PROVIDER=supabase

# Supabase storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sources

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Audio overview TTS (optional)
#
# Three backends are wired up:
#
#   - Deepgram (cloud)  -- set DEEPGRAM_API_KEY below.
#   - Kokoro in-process via kokoro-js -- enabled by default. The library
#     is lazy-loaded; nothing runs until a user actually picks Kokoro
#     in the UI. Works in `next dev`. On Vercel's serverless runtime it
#     may fail to import or time out — set KOKORO_DISABLE_LOCAL=1 to
#     forbid it on those hosts.
#   - Kokoro-FastAPI (HTTP)  -- run the bundled container, then set
#     KOKORO_BASE_URL. Recommended for production.
# ----------------------------------------------------------------------------

# Deepgram (cloud)
DEEPGRAM_API_KEY=

# Kokoro-FastAPI (HTTP). Spin it up from docker/searxng/docker-compose.yml:
#   docker compose --profile tts up -d kokoro
# (or use `ghcr.io/remsky/kokoro-fastapi-gpu:latest` if you have CUDA).
# KOKORO_API_KEY is only needed if you started the server with auth.
# KOKORO_MODEL defaults to `kokoro` and almost never needs to change.
# KOKORO_BASE_URL=http://localhost:8880/v1
# KOKORO_API_KEY=
# KOKORO_MODEL=kokoro

# Set to "1" to forbid the in-process kokoro-js backend (recommended on
# Vercel and other strict serverless platforms).
# KOKORO_DISABLE_LOCAL=1
