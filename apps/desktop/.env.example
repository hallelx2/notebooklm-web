# Desktop runs against in-process PGlite + local-FS storage by default —
# none of the heavy infra env vars (DATABASE_URL, BETTER_AUTH_SECRET,
# ENCRYPTION_KEY) are required. They get auto-generated on first launch
# and persisted to <NOTEBOOKLM_DATA_DIR>/config.json.
#
# Use this file when you want to override any of the defaults below.
#
# Where to put it depends on how you're running the app:
#
#   1. Dev (`bun run dev:desktop`): copy this file to
#      `apps/desktop/.env`. Vite loads it automatically and the Hono
#      middleware sees every value via `process.env`.
#
#   2. Packaged Electron build (the .exe / .dmg / .deb / .AppImage):
#      copy this file to `<NOTEBOOKLM_DATA_DIR>/.env`. By default
#      that's:
#         Windows:  C:\Users\<you>\.notebooklm\.env
#         macOS:    ~/.notebooklm/.env
#         Linux:    ~/.notebooklm/.env
#      The data-dir loader in `apps/desktop/src/server/stub-adapter
#      .ts` reads this on adapter boot and merges into `process.env`
#      for keys the surrounding shell hasn't already exported. The
#      file persists across app reinstalls and upgrades.

# ----------------------------------------------------------------------------
# Data directory (where PGlite + storage + config + window-state live)
# ----------------------------------------------------------------------------
# Default: ~/.notebooklm
# Special: NOTEBOOKLM_DATA_DIR=memory:  -- run fully in-memory (test only)
# NOTEBOOKLM_DATA_DIR=

# ----------------------------------------------------------------------------
# Web search for /api/deep-research (optional)
# ----------------------------------------------------------------------------
# Pick one or more. Default fallback chain is exa -> tavily -> searxng.

# EXA_API_KEY=
# TAVILY_API_KEY=

# SearxNG (open-source, self-hostable).
#
# Auto-start: if Docker is on PATH, SEARXNG_URL is unset, and you haven't
# disabled it, the desktop adapter (apps/desktop/src/server/searxng-
# manager.ts) automatically runs `docker compose up -d` from
# <NOTEBOOKLM_DATA_DIR>/searxng/ on first launch. The compose stack is
# the same one bundled at docker/searxng/ in the repo. No setup needed
# beyond installing Docker.
#
# Override the auto-start in three ways:
#   1. Point at an existing instance:
# SEARXNG_URL=http://localhost:8888
#   2. Disable auto-start entirely (provider stays unavailable unless
#      you also set SEARXNG_URL):
# NOTEBOOKLM_SEARXNG_AUTOSTART=0
#   3. Use a non-default port (default 8888):
# NOTEBOOKLM_SEARXNG_PORT=9999

# Optional ordering override (comma-separated):
# SEARCH_PROVIDER_ORDER=searxng,exa,tavily

# ----------------------------------------------------------------------------
# Audio overview TTS
#
# Out of the box the desktop app uses Kokoro in-process via the
# `kokoro-js` library — no Docker, no Python, no env vars. The model
# (~80MB at q8) downloads from Hugging Face on first use and caches
# under your transformers.js cache directory.
#
# You only need the env vars below if you want to:
#   1. Use Deepgram (cloud TTS) instead of / alongside Kokoro
#   2. Run Kokoro-FastAPI in Docker and route through HTTP instead
#      of using the in-process library (e.g. to share one Kokoro
#      server across multiple machines)
#   3. Tune the in-process backend (quantization, device, model id)
# ----------------------------------------------------------------------------

# Deepgram (cloud)
# DEEPGRAM_API_KEY=

# Kokoro-FastAPI (HTTP). Spin it up from docker/searxng/docker-compose.yml:
#   docker compose --profile tts up -d kokoro
# Then point the app at it. When KOKORO_BASE_URL is set the in-process
# backend is bypassed for Kokoro requests.
# KOKORO_BASE_URL=http://localhost:8880/v1
# KOKORO_API_KEY=
# KOKORO_MODEL=kokoro

# Kokoro in-process (kokoro-js) tuning — leave unset to accept the
# defaults. dtype: q8 (default) | q4 | q4f16 | fp16 | fp32. Smaller
# values are faster + smaller, fp32 needs a GPU to be worthwhile.
# Device: cpu (default) | webgpu | wasm. For real GPU acceleration use
# the Kokoro-FastAPI GPU image instead — kokoro-js doesn't have a CUDA
# path on Node.js right now.
# KOKORO_LOCAL_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
# KOKORO_LOCAL_DTYPE=q8
# KOKORO_LOCAL_DEVICE=cpu

# Set to "1" to disable the in-process kokoro-js backend entirely (the
# server will only accept Deepgram / Kokoro-FastAPI from then on).
# KOKORO_DISABLE_LOCAL=0

# Override the audio-overview's per-request TTS concurrency (number of
# segments generated in parallel via the sliding-window pool). Must be
# 1..32. Defaults: 8 (Deepgram), 4 (Kokoro-FastAPI), 2 (in-process
# kokoro-js — single ONNX session can't go faster than this anyway).
# STUDIO_TTS_CONCURRENCY=4

# ----------------------------------------------------------------------------
# Claude Agent SDK runtime (opt-in — Phase 3)
# ----------------------------------------------------------------------------
# When set to "1" AND the user has an Anthropic credential saved, the
# deep-research handler routes through @anthropic-ai/claude-agent-sdk's
# native sub-agents instead of the AI SDK's manual orchestration.
# Disabled by default because the SDK launches a `claude` Code subprocess
# that doesn't fit Vercel's serverless runtime.
# NOTEBOOKLM_ENABLE_CLAUDE_AGENT_SDK=1
