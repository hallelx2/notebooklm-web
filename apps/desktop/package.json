{
  "name": "@notebooklm/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c \"cyan,magenta\" \"bun run dev:vite\" \"wait-on -t 60000 -i 500 http-get://localhost:5173 && bun run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev:browser": "vite",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notebooklm/core": "workspace:*",
    "@notebooklm/server": "workspace:*",
    "@notebooklm/ui": "workspace:*",
    "@ai-sdk/react": "catalog:",
    "@electric-sql/pglite": "^0.2.17",
    "@hono/node-server": "^1.13.0",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.95.0",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.notebooklm.desktop",
    "productName": "NotebookLM",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "electron/**/*"],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
