{
  "name": "@notebooklm/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first NotebookLM clone — chat, research, and audio overviews over your sources.",
  "author": "NotebookLM <noreply@notebooklm.local>",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c \"cyan,magenta\" \"bun run dev:vite\" \"wait-on -t 180000 -i 500 http-get://localhost:5173 && bun run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev:browser": "vite",
    "build": "vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "build:models": "node scripts/fetch-bundled-models.mjs",
    "build:electron": "bun run build:icon && bun run build:models && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@electric-sql/pglite": "^0.2.17",
    "@hono/node-server": "^1.13.0",
    "@notebooklm/core": "workspace:*",
    "@notebooklm/server": "workspace:*",
    "@notebooklm/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.95.0",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "electron-updater": "^6.3.9",
    "electron-window-state": "^5.0.3",
    "hono": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.notebooklm.desktop",
    "productName": "NotebookLM",
    "electronVersion": "33.2.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["dist/**/*", "electron/**/*"],
    "extraResources": [
      {
        "from": "resources/kokoro",
        "to": "kokoro",
        "filter": ["**/*"]
      },
      {
        "from": "resources/embed",
        "to": "embed",
        "filter": ["**/*"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hallelx2",
        "repo": "notebooklm-web",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "publisherName": "NotebookLM"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NotebookLM",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "NotebookLM",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "NotebookLM ${version}",
      "icon": "build/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "NotebookLM <noreply@notebooklm.local>",
      "synopsis": "Local-first NotebookLM clone — chat, research, and audio over your sources.",
      "desktop": {
        "Name": "NotebookLM",
        "StartupWMClass": "NotebookLM"
      }
    }
  }
}
