# electron-builder source-resource directory (icons, entitlements, installer
# templates). The default `build` ignore above swallows it; un-ignore so
# `apps/desktop/build/icon.{svg,png}` are tracked.
!apps/desktop/build/
!apps/desktop/build/**

# Bundled ML models — fetched by `bun run build:models` before packaging.
# Big binary blobs that don't belong in git; the prebuild script and HF
# Hub are the source of truth.
apps/desktop/resources/

# esbuild output for the embedded Electron-main API server bundle.
# Built by `bun run build:api-server`; rebuilt every CI run from source.
apps/desktop/dist-electron/
