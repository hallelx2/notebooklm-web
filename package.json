{
  "name": "notebooklm",
  "private": true,
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@types/node": "^20",
      "typescript": "^5",
      "next": "16.1.4",
      "next-themes": "^0.4.6",
      "@tanstack/react-query": "^5.90.20",
      "@trpc/client": "^11.8.1",
      "@trpc/react-query": "^11.8.1",
      "@trpc/server": "^11.8.1",
      "@ai-sdk/react": "^3.0.170",
      "ai": "^6.0.168",
      "zod": "^4.3.6",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "better-auth": "^1.4.17",
      "tailwindcss": "^4",
      "@tailwindcss/postcss": "^4",
      "hono": "^4.6.13",
      "@hono/trpc-server": "^0.4.0",
      "clsx": "^2.1.1",
      "class-variance-authority": "^0.7.1",
      "tailwind-merge": "^3.5.0",
      "lucide-react": "^1.6.0",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1"
    }
  },
  "scripts": {
    "dev:web": "bun --filter @notebooklm/web dev",
    "dev:desktop": "bun --filter @notebooklm/desktop dev",
    "build:web": "bun --filter @notebooklm/web build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check",
    "format": "biome format --write",
    "db:push": "bun --filter @notebooklm/web db:push",
    "db:studio": "bun --filter @notebooklm/web db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0"
  },
  "trustedDependencies": ["sharp", "unrs-resolver", "electron", "electron-builder"],
  "ignoreScripts": ["sharp", "unrs-resolver"]
}
